# ---------------------------------------------------------------------------
# Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Site key is public by design and is inlined into the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key is SERVER-ONLY. It must never carry the NEXT_PUBLIC_ prefix,
# because that prefix publishes the value into the browser bundle.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# EmailJS  (sending now happens server-side in app/api/contact/route.ts)
# ---------------------------------------------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Server-only. Found under EmailJS → Account → General → API Keys.
# Server-side sending also requires enabling
# "Allow EmailJS API for non-browser applications" under Account → Security.
EMAILJS_PRIVATE_KEY=
